{
  "name": "blacksite",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build:wasm": "PATH=\"$HOME/.cargo/bin:$PATH\" rustup target add wasm32-unknown-unknown && PATH=\"$HOME/.cargo/bin:$PATH\" cargo build --manifest-path engine/Cargo.toml --target wasm32-unknown-unknown --release && cp engine/target/wasm32-unknown-unknown/release/blacksite.wasm public/blacksite.wasm && node scripts/check-wasm-sync.mjs --update",
    "build": "vite build",
    "build:pages": "vite build --config vite.pages.config.ts && node scripts/pages-finish.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "check:wasm": "node scripts/check-wasm-sync.mjs",
    "check:assets": "node --experimental-strip-types scripts/check-assets.mjs",
    "check:environment": "node scripts/check-environment-assets.mjs",
    "assets:environment": "python3 scripts/process-blacksite-environment-assets.py",
    "assets:weapons": "python3 scripts/process-blacksite-weapons.py",
    "assets:projectiles": "python3 scripts/process-blacksite-projectile-assets.py",
    "check:maps": "python3 scripts/build-sector-layout-data.py --check",
    "check:projectiles": "node scripts/check-projectile-assets.mjs",
    "check:voices": "node scripts/check-voice-assets.mjs",
    "check:motion": "python3 scripts/check-blacksite-motion.py",
    "assets:voices": "node scripts/generate-blacksite-voices.mjs",
    "test:voices": "node --experimental-strip-types --test src/game/enemy-presentation.test.ts",
    "test:browser": "node --experimental-strip-types --test scripts/arsenal.browser.mjs scripts/reward-pause.browser.mjs scripts/qa-run.browser.mjs scripts/campaign25.browser.mjs scripts/boss-counterplay.browser.mjs",
    "test:pages": "node --experimental-strip-types --test scripts/pages-arsenal.browser.mjs",
    "test": "node --experimental-strip-types --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test src/components/game/data.test.ts src/game/hud-abi.test.ts src/game/save-abi.test.ts src/game/runtime.test.ts src/game/dev-run.test.ts src/game/voice-gate.test.ts src/game/sfx-director.test.ts src/game/hurt-direction.test.ts src/lib/storage-migration.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "assets:sfx": "python3 scripts/process-blacksite-sfx.py",
    "check:sfx": "node --test scripts/sfx-assets.test.mjs",
    "test:ai:smoke": "node --experimental-strip-types scripts/ai/smoke.mjs",
    "test:ai:short": "node --experimental-strip-types scripts/ai/playtest.mjs",
    "test:ai:approaches": "node --experimental-strip-types scripts/ai/experiments.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.168.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.0.0",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.6.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@webgpu/types": "^0.1.74",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0"
  }
}
